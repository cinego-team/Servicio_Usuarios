{
    "name": "users-api",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:usuarios": "cd ../Servicio_Usuarios && npm run start:dev",
        "start:peliculas": "cd ../Servicio_Peliculas && npm run start:dev",
        "start:ventas": "cd ../Servicio_Ventas && npm run start:dev",
        "start:promociones": "cd ../ServicioPromociones && npm run start:dev",
        "start:funcionesysalas": "cd ../Servicio_Funciones_y_Salas && npm run start:dev",
        "start:apigateway": "cd ../apigateway && npm run start:dev",
        "start:envioemails": "cd ../Servicio_Envio_Emails && npm run start:dev",
        "start:integracionmercadopago": "cd ../Servicio_Integracion_MercadoPago && npm run start:dev",
        "start:frontcliente": "cd ../Fronted-Usuario && ng serve",
        "start:frontempleado": "cd ../Fronted-Empleado && ng serve",
        "start:all": "concurrently -c \"red,green,yellow,blue,magenta,cyan,white,gray,bgBlue,bgMagenta\" \"npm run start:usuarios\" \"npm run start:peliculas\" \"npm run start:ventas\" \"npm run start:promociones\" \"npm run start:funcionesysalas\" \"npm run start:apigateway\" \"npm run start:envioemails\"\"npm run start:integracionmercadopago\" \"npm run start:frontcliente\" \"npm run start:frontempleado\"",
        "start:rama": "concurrently -c \"red,green,yellow,blue,magenta,cyan,white,gray,bgBlue,bgMagenta\" \"npm run start:usuarios\" \"npm run start:peliculas\" \"npm run start:ventas\" \"npm run start:promociones\" \"npm run start:funcionesysalas\" \"npm run start:apigateway\" \"npm run start:frontcliente\"",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.20",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^10.4.20",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "*",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/typeorm": "^10.0.2",
        "axios": "^1.13.2",
        "bcrypt": "^5.1.1",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dayjs": "^1.11.13",
        "jsonwebtoken": "^9.0.2",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.2",
        "sqlite3": "^5.1.7",
        "typeorm": "^0.3.20"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.0.0",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.17",
        "@types/jest": "^29.5.14",
        "@types/node": "^20.3.1",
        "@types/passport": "^1.0.17",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "concurrently": "^9.2.1",
        "eslint": "^8.42.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.0.0",
        "source-map-support": "^0.5.21",
        "supertest": "^6.3.3",
        "ts-jest": "^29.4.1",
        "ts-loader": "^9.4.3",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.1.3"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
